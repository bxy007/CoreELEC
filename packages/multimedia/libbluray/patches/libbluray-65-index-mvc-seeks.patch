+static int _stc_spn_range(const CLPI_CL *cl, uint8_t stc_id, uint32_t *start, uint32_t *end)
+{
+    for (unsigned i = 0; i < cl->sequence.num_atc_seq; i++) {
+        const CLPI_ATC_SEQ *atc = &cl->sequence.atc_seq[i];
+        if (stc_id < atc->offset_stc_id || stc_id >= atc->offset_stc_id + atc->num_stc_seq)
+            continue;
+
+        unsigned index = stc_id - atc->offset_stc_id;
+        *start = atc->stc_seq[index].spn_stc_start;
+        if (index + 1 < atc->num_stc_seq)
+            *end = atc->stc_seq[index + 1].spn_stc_start;
+        else if (i + 1 < cl->sequence.num_atc_seq)
+            *end = cl->sequence.atc_seq[i + 1].spn_atc_start;
+        else
+            *end = cl->clip.num_source_packets;
+        return *start < *end && *end <= cl->clip.num_source_packets;
+    }
+    return 0;
+}
+
+int clpi_lookup_mvc_spn(const CLPI_CL *base, uint32_t base_spn, uint8_t base_stc,
+                       const CLPI_CL *mvc, uint16_t mvc_pid, uint8_t mvc_stc, uint32_t *mvc_spn)
+{
+    uint32_t base_start, base_end, mvc_start, mvc_end;
+    uint32_t pts, spn, mvc_pts, matching_spn;
+
+    if (!base->cpi.num_stream_pid || !base->cpi.entry || !mvc->cpi_ss.entry ||
+        !_stc_spn_range(base, base_stc, &base_start, &base_end) ||
+        !_stc_spn_range(mvc, mvc_stc, &mvc_start, &mvc_end) ||
+        base_spn < base_start || base_spn >= base_end)
+        return 0;
+
+    const CLPI_EP_MAP_ENTRY *view = _find_ep_map(&mvc->cpi_ss, mvc_pid);
+    // A time seek can leave the base view one packet before its CPI entry.
+    if (!view || !_find_ep(&base->cpi.entry[0], base_spn, NULL, &pts, &spn) ||
+        spn >= base_end || spn - base_spn > 1 ||
+        !_find_ep(view, mvc_start, &pts, &mvc_pts, &matching_spn) || matching_spn >= mvc_end)
+        return 0;
+
+    *mvc_spn = matching_spn;
+    return 1;
+}
+
 // Looks up the start packet number that is closest to the requested packet
