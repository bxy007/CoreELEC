+int64_t bd_get_mvc_seek_offset(BLURAY *bd, unsigned subpath, const char *file, uint16_t pid)
+{
+    int64_t offset = -1;
+    if (!bd || !file)
+        return -1;
+
+    bd_mutex_lock(&bd->mutex);
+    const NAV_CLIP *clip = bd->st0.clip;
+    if (!bd->title || !bd->title->pl || !clip || !clip->cl || !bd->st0.seek_flag)
+        goto out;
+
+    const MPLS_PL *pl = bd->title->pl;
+    if (!pl->play_item || clip->ref >= pl->list_count ||
+        !pl->ext_sub_path || subpath >= pl->ext_sub_count)
+        goto out;
+
+    const MPLS_PI *item = &pl->play_item[clip->ref];
+    const MPLS_SUB *sub = &pl->ext_sub_path[subpath];
+    if (sub->type != mpls_sub_path_ss_video || !sub->sub_play_item ||
+        clip->ref >= sub->sub_playitem_count || !item->clip || clip->angle >= item->angle_count ||
+        !item->stn.num_video || !item->stn.video || !clip->cl->cpi.num_stream_pid ||
+        !clip->cl->cpi.entry || clip->cl->cpi.entry[0].pid != item->stn.video[0].pid)
+        goto out;
+
+    const MPLS_SUB_PI *view = &sub->sub_play_item[clip->ref];
+    if (!view->clip || view->clip_count != 1 || view->sync_play_item_id != clip->ref ||
+        view->in_time != view->sync_pts)
+        goto out;
+
+    char filename[11];
+    snprintf(filename, sizeof(filename), "%.5s.m2ts", view->clip->clip_id);
+    if (strcmp(file, filename))
+        goto out;
+
+    const uint64_t base_spn = bd->st0.clip_pos / 192;
+    if (bd->st0.clip_pos % 192 || base_spn < clip->start_pkt || base_spn >= clip->end_pkt)
+        goto out;
+
+    snprintf(filename, sizeof(filename), "%.5s.clpi", view->clip->clip_id);
+    const CLPI_CL *mvc = clpi_get(bd->disc, filename);
+    if (mvc) {
+        uint32_t spn;
+        if (clpi_lookup_mvc_spn(clip->cl, (uint32_t)base_spn, item->clip[clip->angle].stc_id,
+                                mvc, pid, view->clip->stc_id, &spn))
+            offset = (int64_t)spn * 192;
+        clpi_unref(&mvc);
+    }
+
+out:
+    bd_mutex_unlock(&bd->mutex);
+    return offset;
+}
