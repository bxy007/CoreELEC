+unsigned bd_get_in_mux_pip_layout(BLURAY *bd, uint32_t playlist, unsigned playitem,
+                                  unsigned stream, BLURAY_PIP_LAYOUT *layout,
+                                  BLURAY_PIP_PLACEMENT *placements, unsigned capacity)
+{
+    unsigned count = 0;
+    if (!bd || !layout || !stream || playlist > 99999)
+        return 0;
+
+    bd_mutex_lock(&bd->mutex);
+    if (!bd->title || !bd->title->pl)
+        goto out;
+
+    char *end;
+    if (strtoul(bd->title->name, &end, 10) != playlist ||
+        end == bd->title->name || strcmp(end, ".mpls"))
+        goto out;
+
+    const MPLS_PL *pl = bd->title->pl;
+    if (!pl->play_item || playitem >= pl->list_count || !pl->ext_pip_data)
+        goto out;
+
+    const MPLS_PI *item = &pl->play_item[playitem];
+    if (!item->stn.secondary_video || stream > item->stn.num_secondary_video)
+        goto out;
+
+    const MPLS_STREAM *video = &item->stn.secondary_video[stream - 1];
+    if (video->stream_type != 3 || !pl->sub_path || video->subpath_id >= pl->sub_count ||
+        pl->sub_path[video->subpath_id].type != mpls_sub_path_sync_pip)
+        goto out;
+
+    for (unsigned i = 0; i < pl->ext_pip_data_count; i++) {
+        const MPLS_PIP_METADATA *data = &pl->ext_pip_data[i];
+        if (data->clip_ref != playitem || data->secondary_video_ref != stream - 1 ||
+            data->timeline_type != pip_timeline_sync_mainpath || !data->data_count || !data->data)
+            continue;
+
+        count = data->data_count;
+        layout->pid = video->pid;
+        layout->in_time = item->in_time;
+        layout->out_time = item->out_time;
+        layout->luma_key = data->luma_key_flag ? data->upper_limit_luma_key : -1;
+        layout->trick_play = data->trick_play_flag;
+        if (placements && capacity >= count) {
+            for (unsigned n = 0; n < count; n++) {
+                placements[n].time = data->data[n].time;
+                placements[n].x = data->data[n].xpos;
+                placements[n].y = data->data[n].ypos;
+                placements[n].scale = data->data[n].scale_factor;
+            }
+        }
+        break;
+    }
+
+out:
+    bd_mutex_unlock(&bd->mutex);
+    return count;
+}
