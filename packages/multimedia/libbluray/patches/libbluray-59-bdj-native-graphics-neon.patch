+
+static inline uint32_t bdg_alpha_scale16(jfloat extraAlpha)
+{
+    if (extraAlpha <= 0.0f)
+        return 0u;
+    if (extraAlpha >= 0.9999f)
+        return 65536u;
+    return (uint32_t)(extraAlpha * 65536.0f + 0.5f);
+}
+
+static inline uint32_t bdg_apply_alpha(uint32_t px, uint32_t alphaScale16)
+{
+    if (alphaScale16 >= 65536u)
+        return px;
+    uint32_t a = ((px >> 24) * alphaScale16) >> 16;
+    return (a << 24) | (px & 0x00FFFFFFu);
+}
+
+static inline uint32_t bdg_blend_pixel(uint32_t dest, uint32_t src, uint32_t As)
+{
+    if (As == 0u)
+        return dest;
+    if (As == 255u)
+        return 0xFF000000u | (src & 0x00FFFFFFu);
+    uint32_t Ad = dest >> 24;
+    if (Ad == 0u)
+        return (As << 24) | (src & 0x00FFFFFFu);
+    if (Ad == 255u) {
+        uint32_t inv = 255u - As;
+        uint32_t r = ((src >> 16) & 255u) * As + ((dest >> 16) & 255u) * inv;
+        uint32_t g = ((src >> 8) & 255u) * As + ((dest >> 8) & 255u) * inv;
+        uint32_t b = (src & 255u) * As + (dest & 255u) * inv;
+        r = (r + 1u + (r >> 8)) >> 8;
+        g = (g + 1u + (g >> 8)) >> 8;
+        b = (b + 1u + (b >> 8)) >> 8;
+        return 0xFF000000u | (r << 16) | (g << 8) | b;
+    }
+    uint32_t As255 = As * 255u;
+    uint32_t AdTerm = Ad * (255u - As);
+    uint32_t outA255 = As255 + AdTerm;
+    float invA = 1.0f / (float)outA255;
+    uint32_t r = (uint32_t)(((float)(((src >> 16) & 255u) * As255 + ((dest >> 16) & 255u) * AdTerm)) * invA + 0.5f);
+    uint32_t g = (uint32_t)(((float)(((src >> 8) & 255u) * As255 + ((dest >> 8) & 255u) * AdTerm)) * invA + 0.5f);
+    uint32_t b = (uint32_t)(((float)((src & 255u) * As255 + (dest & 255u) * AdTerm)) * invA + 0.5f);
+    if (r > 255u) r = 255u;
+    if (g > 255u) g = 255u;
+    if (b > 255u) b = 255u;
+    uint32_t outA = (outA255 * 32897u) >> 23;
+    if (outA > 255u) outA = 255u;
+    return (outA << 24) | (r << 16) | (g << 8) | b;
+}
+
+static void bdg_blend_span_src_over(uint32_t *dst, const uint32_t *src,
+                                    int len, uint32_t alphaScale16)
+{
+    if (len <= 0 || alphaScale16 == 0u)
+        return;
+
+    size_t n = (size_t)len;
+    size_t idx = 0u;
+    const int hasScale = (alphaScale16 < 65536u);
+
+#if BDG_HAS_NEON
+    const uint16x8_t vOne16 = vdupq_n_u16(1u);
+    const uint8x8_t vFF = vdup_n_u8(255u);
+    const uint16x4_t vScale16 = vdup_n_u16((uint16_t)alphaScale16);
+
+    for (; idx + 8u <= n; idx += 8u) {
+        uint8x8x4_t sv = vld4_u8((const uint8_t *)(src + idx));
+        uint8x8_t sa = sv.val[3];
+        if (hasScale) {
+            uint16x8_t sa16 = vmovl_u8(sa);
+            uint16x4_t lo16 = vshrn_n_u32(vmull_u16(vget_low_u16(sa16), vScale16), 16);
+            uint16x4_t hi16 = vshrn_n_u32(vmull_u16(vget_high_u16(sa16), vScale16), 16);
+            sa = vmovn_u16(vcombine_u16(lo16, hi16));
+        }
+        uint64_t sa64 = vget_lane_u64(vreinterpret_u64_u8(sa), 0);
+        if (sa64 == 0ULL)
+            continue;
+        if (sa64 == 0xFFFFFFFFFFFFFFFFULL) {
+            memcpy(dst + idx, src + idx, 32u);
+            continue;
+        }
+        uint8x8x4_t dv = vld4_u8((const uint8_t *)(dst + idx));
+        uint64_t da64 = vget_lane_u64(vreinterpret_u64_u8(dv.val[3]), 0);
+        if (da64 == 0xFFFFFFFFFFFFFFFFULL) {
+            uint8x8_t invSa = vsub_u8(vFF, sa);
+            uint16x8_t b16 = vmlal_u8(vmull_u8(sv.val[0], sa), dv.val[0], invSa);
+            uint16x8_t g16 = vmlal_u8(vmull_u8(sv.val[1], sa), dv.val[1], invSa);
+            uint16x8_t r16 = vmlal_u8(vmull_u8(sv.val[2], sa), dv.val[2], invSa);
+            dv.val[0] = vshrn_n_u16(vaddq_u16(vaddq_u16(b16, vOne16), vshrq_n_u16(b16, 8)), 8);
+            dv.val[1] = vshrn_n_u16(vaddq_u16(vaddq_u16(g16, vOne16), vshrq_n_u16(g16, 8)), 8);
+            dv.val[2] = vshrn_n_u16(vaddq_u16(vaddq_u16(r16, vOne16), vshrq_n_u16(r16, 8)), 8);
+            dv.val[3] = vFF;
+            vst4_u8((uint8_t *)(dst + idx), dv);
+            continue;
+        }
+        if (da64 == 0ULL) {
+            uint8x8_t mask = vtst_u8(sa, sa);
+            dv.val[0] = vbsl_u8(mask, sv.val[0], dv.val[0]);
+            dv.val[1] = vbsl_u8(mask, sv.val[1], dv.val[1]);
+            dv.val[2] = vbsl_u8(mask, sv.val[2], dv.val[2]);
+            dv.val[3] = sa;
+            vst4_u8((uint8_t *)(dst + idx), dv);
+            continue;
+        }
+        for (size_t lane = 0u; lane < 8u; lane++) {
+            uint32_t sp = src[idx + lane];
+            uint32_t As = sp >> 24;
+            if (hasScale)
+                As = (As * alphaScale16) >> 16;
+            dst[idx + lane] = bdg_blend_pixel(dst[idx + lane], sp, As);
+        }
+    }
+#endif
+
+    for (size_t rem = n - idx; rem > 0u; rem--, idx++) {
+        uint32_t sp = src[idx];
+        uint32_t As = sp >> 24;
+        if (hasScale)
+            As = (As * alphaScale16) >> 16;
+        dst[idx] = bdg_blend_pixel(dst[idx], sp, As);
+    }
+}
+
+static void bdg_blend_span_src_over_flipx(uint32_t *dst, const uint32_t *src,
+                                          int len, uint32_t alphaScale16)
+{
+    const int hasScale = (alphaScale16 < 65536u);
+    for (int i = 0; i < len; i++) {
+        uint32_t sp = src[len - 1 - i];
+        uint32_t As = sp >> 24;
+        if (hasScale)
+            As = (As * alphaScale16) >> 16;
+        dst[i] = bdg_blend_pixel(dst[i], sp, As);
+    }
+}
+
+static void bdg_copy_span_src(uint32_t *dst, const uint32_t *src,
+                              int len, int flipX, uint32_t alphaScale16)
+{
+    if (len <= 0)
+        return;
+    if (!flipX) {
+        if (alphaScale16 >= 65536u) {
+            memmove(dst, src, (size_t)len * sizeof(uint32_t));
+            return;
+        }
+        for (int i = 0; i < len; i++) {
+            dst[i] = bdg_apply_alpha(src[i], alphaScale16);
+        }
+    } else {
+        for (int i = 0; i < len; i++) {
+            dst[i] = bdg_apply_alpha(src[len - 1 - i], alphaScale16);
+        }
+    }
+}
+
+static void bdg_fill_span(uint32_t *dst, int len, uint32_t argb, int rule, uint32_t alphaScale16)
+{
+    if (len <= 0)
+        return;
+
+    if (rule == BDG_RULE_CLEAR) {
+        memset(dst, 0, (size_t)len * sizeof(uint32_t));
+        return;
+    }
+
+    uint32_t px = bdg_apply_alpha(argb, alphaScale16);
+    if (rule == BDG_RULE_SRC) {
+        for (int i = 0; i < len; i++)
+            dst[i] = px;
+        return;
+    }
+
+    if (rule == BDG_RULE_SRC_OVER) {
+        uint32_t As = px >> 24;
+        if (As == 0u)
+            return;
+        if (As == 255u) {
+            for (int i = 0; i < len; i++)
+                dst[i] = px;
+            return;
+        }
+        size_t n = (size_t)len;
+        size_t idx = 0u;
+#if BDG_HAS_NEON
+        const uint8x8_t vSa = vdup_n_u8((uint8_t)As);
+        const uint8x8_t vInvSa = vdup_n_u8((uint8_t)(255u - As));
+        const uint8x8_t vFF = vdup_n_u8(255u);
+        const uint16x8_t vOne16 = vdupq_n_u16(1u);
+        const uint16x8_t vSr = vmull_u8(vdup_n_u8((uint8_t)((px >> 16) & 255u)), vSa);
+        const uint16x8_t vSg = vmull_u8(vdup_n_u8((uint8_t)((px >> 8) & 255u)), vSa);
+        const uint16x8_t vSb = vmull_u8(vdup_n_u8((uint8_t)(px & 255u)), vSa);
+        for (; idx + 8u <= n; idx += 8u) {
+            uint8x8x4_t dv = vld4_u8((const uint8_t *)(dst + idx));
+            uint64_t da64 = vget_lane_u64(vreinterpret_u64_u8(dv.val[3]), 0);
+            if (da64 == 0xFFFFFFFFFFFFFFFFULL) {
+                uint16x8_t b16 = vmlal_u8(vSb, dv.val[0], vInvSa);
+                uint16x8_t g16 = vmlal_u8(vSg, dv.val[1], vInvSa);
+                uint16x8_t r16 = vmlal_u8(vSr, dv.val[2], vInvSa);
+                dv.val[0] = vshrn_n_u16(vaddq_u16(vaddq_u16(b16, vOne16), vshrq_n_u16(b16, 8)), 8);
+                dv.val[1] = vshrn_n_u16(vaddq_u16(vaddq_u16(g16, vOne16), vshrq_n_u16(g16, 8)), 8);
+                dv.val[2] = vshrn_n_u16(vaddq_u16(vaddq_u16(r16, vOne16), vshrq_n_u16(r16, 8)), 8);
+                dv.val[3] = vFF;
+                vst4_u8((uint8_t *)(dst + idx), dv);
+                continue;
+            }
+            if (da64 == 0ULL) {
+                for (size_t lane = 0u; lane < 8u; lane++)
+                    dst[idx + lane] = px;
+                continue;
+            }
+            for (size_t lane = 0u; lane < 8u; lane++)
+                dst[idx + lane] = bdg_blend_pixel(dst[idx + lane], px, As);
+        }
+#endif
+        for (size_t rem = n - idx; rem > 0u; rem--, idx++) {
+            dst[idx] = bdg_blend_pixel(dst[idx], px, As);
+        }
+    }
+}
+
+JNIEXPORT void JNICALL
+Java_java_awt_BDGraphics_fillRectN(JNIEnv *env, jclass cls,
+                                   jintArray jdst, jint dstStride, jint dstH,
+                                   jint x, jint y, jint w, jint h,
+                                   jint argb, jint rule, jfloat extraAlpha)
+{
+    if (!jdst || dstStride <= 0 || dstH <= 0 || w <= 0 || h <= 0)
+        return;
+
+    int rx0 = x < 0 ? 0 : x;
+    int ry0 = y < 0 ? 0 : y;
+    int rx1 = x + w;
+    int ry1 = y + h;
+    if (rx1 > dstStride) rx1 = dstStride;
+    if (ry1 > dstH) ry1 = dstH;
+    int rw = rx1 - rx0;
+    int rh = ry1 - ry0;
+    if (rw <= 0 || rh <= 0)
+        return;
+
+    jsize dstLen = (*env)->GetArrayLength(env, jdst);
+    if ((int64_t)(ry1 - 1) * (int64_t)dstStride + (int64_t)rx1 > (int64_t)dstLen)
+        return;
+
+    uint32_t alphaScale16 = bdg_alpha_scale16(extraAlpha);
+    uint32_t *dst = (uint32_t *)(*env)->GetPrimitiveArrayCritical(env, jdst, NULL);
+    if (!dst)
+        return;
+
+    for (int row = ry0; row < ry1; row++) {
+        bdg_fill_span(dst + (size_t)row * (size_t)dstStride + (size_t)rx0,
+                      rw, (uint32_t)argb, (int)rule, alphaScale16);
+    }
+
+    (*env)->ReleasePrimitiveArrayCritical(env, jdst, dst, 0);
+}
+
+JNIEXPORT void JNICALL
+Java_java_awt_BDGraphics_blitN(JNIEnv *env, jclass cls,
+                               jintArray jdst, jint dstStride, jint dstH,
+                               jint dx, jint dy, jint w, jint h,
+                               jint clipX0, jint clipY0, jint clipX1, jint clipY1,
+                               jintArray jsrc, jint srcStride, jint srcH,
+                               jint sx, jint sy,
+                               jboolean flipX, jboolean flipY,
+                               jint rule, jfloat extraAlpha)
+{
+    if (!jdst || !jsrc || dstStride <= 0 || dstH <= 0 || srcStride <= 0 || srcH <= 0 || w <= 0 || h <= 0)
+        return;
+
+    if (clipX0 < 0) clipX0 = 0;
+    if (clipY0 < 0) clipY0 = 0;
+    if (clipX1 > dstStride) clipX1 = dstStride;
+    if (clipY1 > dstH) clipY1 = dstH;
+
+    int rx0 = dx > clipX0 ? dx : clipX0;
+    int ry0 = dy > clipY0 ? dy : clipY0;
+    int rx1 = (dx + w) < clipX1 ? (dx + w) : clipX1;
+    int ry1 = (dy + h) < clipY1 ? (dy + h) : clipY1;
+    if (rx0 >= rx1 || ry0 >= ry1)
