+JNIEXPORT jintArray JNICALL
+Java_java_awt_BDToolkitBase_decodePngN(JNIEnv *env, jclass cls,
+                                       jbyteArray jdata, jint off, jint len, jintArray jdims)
+{
+#ifdef HAVE_LIBPNG
+    if (!jdata || !jdims || off < 0 || len < 8)
+        return NULL;
+
+    jsize dataArrLen = (*env)->GetArrayLength(env, jdata);
+    jsize dimsArrLen = (*env)->GetArrayLength(env, jdims);
+    if (dimsArrLen < 2 || (int64_t)off + (int64_t)len > (int64_t)dataArrLen)
+        return NULL;
+
+    uint8_t sig[8];
+    (*env)->GetByteArrayRegion(env, jdata, off, 8, (jbyte *)sig);
+    if ((*env)->ExceptionCheck(env) || png_sig_cmp(sig, 0, 8) != 0) {
+        (*env)->ExceptionClear(env);
+        return NULL;
+    }
+
+    uint8_t *inBuf = (uint8_t *)malloc((size_t)len);
+    if (!inBuf)
+        return NULL;
+
+    (*env)->GetByteArrayRegion(env, jdata, off, len, (jbyte *)inBuf);
+    if ((*env)->ExceptionCheck(env)) {
+        (*env)->ExceptionClear(env);
+        free(inBuf);
+        return NULL;
+    }
+
+    png_structp png_ptr = png_create_read_struct(PNG_LIBPNG_VER_STRING, NULL, NULL, bdg_png_warn_cb);
+    if (!png_ptr) {
+        free(inBuf);
+        return NULL;
+    }
+
+    png_infop info_ptr = png_create_info_struct(png_ptr);
+    if (!info_ptr) {
+        png_destroy_read_struct(&png_ptr, NULL, NULL);
+        free(inBuf);
+        return NULL;
+    }
+
+    uint32_t * volatile outBuf = NULL;
+    png_bytep * volatile rows = NULL;
+    png_uint_32 w = 0u;
+    png_uint_32 h = 0u;
+
+    if (setjmp(png_jmpbuf(png_ptr))) {
+        free(rows);
+        free(outBuf);
+        png_destroy_read_struct(&png_ptr, &info_ptr, NULL);
+        free(inBuf);
+        return NULL;
+    }
+
+    bdg_png_reader_t reader;
+    reader.data = inBuf;
+    reader.len = (size_t)len;
+    reader.pos = 0u;
+    png_set_read_fn(png_ptr, &reader, bdg_png_read_cb);
+
+    png_read_info(png_ptr, info_ptr);
+    w = png_get_image_width(png_ptr, info_ptr);
+    h = png_get_image_height(png_ptr, info_ptr);
+    if (w == 0u || h == 0u || w > 8192u || h > 8192u || (uint64_t)w * (uint64_t)h > 33554432ULL) {
+        png_destroy_read_struct(&png_ptr, &info_ptr, NULL);
+        free(inBuf);
+        return NULL;
+    }
+
+    int color_type = png_get_color_type(png_ptr, info_ptr);
+    int bit_depth = png_get_bit_depth(png_ptr, info_ptr);
+
+    if (bit_depth == 16)
+        png_set_strip_16(png_ptr);
+    if (color_type == PNG_COLOR_TYPE_PALETTE)
+        png_set_palette_to_rgb(png_ptr);
+    if (color_type == PNG_COLOR_TYPE_GRAY && bit_depth < 8)
+        png_set_expand_gray_1_2_4_to_8(png_ptr);
+    if (png_get_valid(png_ptr, info_ptr, PNG_INFO_tRNS))
+        png_set_tRNS_to_alpha(png_ptr);
+    if (color_type == PNG_COLOR_TYPE_GRAY || color_type == PNG_COLOR_TYPE_GRAY_ALPHA)
+        png_set_gray_to_rgb(png_ptr);
+    if (color_type == PNG_COLOR_TYPE_RGB || color_type == PNG_COLOR_TYPE_GRAY ||
+        color_type == PNG_COLOR_TYPE_PALETTE)
+        png_set_filler(png_ptr, 0xFF, PNG_FILLER_AFTER);
+
+    /* Java int ARGB (0xAARRGGBB) in memory: [B, G, R, A] on little-endian, [A, R, G, B] on big-endian. */
+#if defined(__BYTE_ORDER__) && (__BYTE_ORDER__ == __ORDER_BIG_ENDIAN__)
+    png_set_swap_alpha(png_ptr);
+#else
+    png_set_bgr(png_ptr);
+#endif
+    png_set_interlace_handling(png_ptr);
+    png_read_update_info(png_ptr, info_ptr);
+
+    size_t pixelCount = (size_t)w * (size_t)h;
+    outBuf = (uint32_t *)malloc(pixelCount * sizeof(uint32_t));
+    rows = (png_bytep *)malloc((size_t)h * sizeof(png_bytep));
+    if (!outBuf || !rows) {
+        free(rows);
+        free(outBuf);
+        png_destroy_read_struct(&png_ptr, &info_ptr, NULL);
+        free(inBuf);
+        return NULL;
+    }
+
+    for (png_uint_32 ry = 0u; ry < h; ry++) {
+        rows[ry] = (png_bytep)(outBuf + (size_t)ry * (size_t)w);
+    }
+
+    png_read_image(png_ptr, rows);
+    png_read_end(png_ptr, NULL);
+
+    free(rows);
+    rows = NULL;
+    png_destroy_read_struct(&png_ptr, &info_ptr, NULL);
+    free(inBuf);
+    inBuf = NULL;
+
+    jintArray result = (*env)->NewIntArray(env, (jsize)pixelCount);
+    if (!result) {
+        free(outBuf);
+        return NULL;
+    }
+
+    (*env)->SetIntArrayRegion(env, result, 0, (jsize)pixelCount, (const jint *)outBuf);
+    free(outBuf);
+
+    if ((*env)->ExceptionCheck(env)) {
+        (*env)->ExceptionClear(env);
+        return NULL;
+    }
