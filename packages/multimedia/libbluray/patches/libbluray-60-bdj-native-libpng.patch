+    jint dims[2];
+    dims[0] = (jint)w;
+    dims[1] = (jint)h;
+    (*env)->SetIntArrayRegion(env, jdims, 0, 2, dims);
+    if ((*env)->ExceptionCheck(env)) {
+        (*env)->ExceptionClear(env);
+        return NULL;
+    }
