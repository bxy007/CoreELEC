From: forbxy <forbxy@github.com>
Date: Wed, 25 Nov 2026 00:35:00 +0800
Subject: [PATCH] hog: persist static HID metadata for fast cold-boot reconnect

BlueZ 5.78 caches GATT service/characteristic structure on disk, but does not
persist static HoG metadata (Report Map 0x2A4B, HID Information 0x2A4A,
Report Reference 0x2908, External Report Reference 0x2907). On the first
reconnection after reboot, bluetoothd therefore runs dozens of serial ATT
reads/writes before creating UHID and registering input notifications,
blocking input readiness for ~2 seconds and dropping early keypresses.

Persist those static read-only HoG attributes in a separate [AttributeValues]
group in the existing GATT cache file (preserving full compatibility with
[Attributes] and automatic invalidation on Service Changed / DB Hash change /
cache clear / re-pairing). Force full characteristic/descriptor rediscovery
of overlapping HID services on Service Changed or Database Hash mismatch so
internal handle moves or metadata updates within the same handle range never
reuse stale structure or values, and rebuild input-hog cleanly when any HID
service is added or removed on multi-HID-service devices.

On cached reconnection, create UHID after populating all report metadata and
register input notification handlers immediately while verifying CCCD and
protocol mode asynchronously in the background (including on warm reconnects
with retained UHID). Only persist Report Map after UHID_START confirms kernel
registration, and recover once via online read if a cached Report Map fails
to reach UHID_START within timeout.

Skip unused initial Report value reads on the gatt_db path, skip redundant
CCCD writes when notifications are already enabled, buffer early input
notifications until UHID_START provides numbered-report flags (discarding
stale queued burst on overflow to prevent stuck keys), retain UHID and its
callbacks across idle temporary disconnects for Bluetooth SIG Remote Control
(GAP Appearance category 0x06) devices while forcing UHID destruction if an
input report is still active on disconnect (preventing stuck keys / runaway
key repeat), detach HoG and cancel in-flight GET/SET report ATT ops on service
removal before attributes are freed, look up cached gatt_db attributes by
handle+UUID, and keep bt_hog referenced across report_map_read_cb().
---
diff --git a/profiles/input/hog-lib.c b/profiles/input/hog-lib.c
index 22599f7..9284c60 100644
--- a/profiles/input/hog-lib.c
+++ b/profiles/input/hog-lib.c
@@ -34,6 +34,7 @@
 #include "src/shared/util.h"
 #include "src/shared/uhid.h"
 #include "src/shared/queue.h"
+#include "src/shared/timeout.h"
 #include "src/shared/att.h"
 #include "src/shared/gatt-db.h"
 #include "src/log.h"
@@ -66,6 +67,16 @@
 
 #define HID_INFO_SIZE			4
 #define ATT_NOTIFICATION_HEADER_SIZE	3
+#define HOG_MAX_PENDING_INPUT		64
+#ifndef HOG_UHID_START_TIMEOUT_MS
+#define HOG_UHID_START_TIMEOUT_MS	2000
+#endif
+
+struct pending_input {
+	struct report		*report;
+	uint16_t		len;
+	uint8_t			data[];
+};
 
 struct bt_hog {
 	int			ref_count;
@@ -96,19 +107,42 @@ struct bt_hog {
 	struct queue		*bas;
 	GSList			*instances;
 	struct queue		*gatt_op;
+	struct queue		*pending_input;
+	bool			pending_input_overflow;
+	unsigned int		uhid_start_id;
+	unsigned int		uhid_output_id;
+	unsigned int		uhid_getrep_id;
+	unsigned int		uhid_setrep_id;
+	unsigned int		uhid_start_timeout;
+	bool			uhid_from_cache;
+	bool			cache_recovery_tried;
+	uint8_t			*pending_report_map;
+	size_t			pending_report_map_len;
 	struct gatt_db		*gatt_db;
-	struct gatt_db_attribute	*report_map_attr;
+	uint16_t		report_map_handle;
+	uint16_t		info_handle;
+	bool			info_pending;
+	unsigned int		ext_pending;
+	bool			has_external_reports;
+	bool			cache_dirty;
+	void			(*cache_updated_cb)(void *user_data);
+	void			*cache_updated_data;
 };
 
 struct report {
 	struct bt_hog		*hog;
 	bool			numbered;
+	bool			ref_known;
+	bool			ref_pending;
+	bool			ccc_read_queued;
+	bool			input_active;
 	uint8_t			id;
 	uint8_t			type;
 	uint16_t		handle;
 	uint16_t		value_handle;
 	uint8_t			properties;
 	uint16_t		ccc_handle;
+	uint16_t		ref_handle;
 	guint			notifyid;
 	uint16_t		len;
 	uint8_t			*value;
@@ -152,6 +186,62 @@ static void destroy_gatt_req(void *data)
 }
 
 static void read_report_map(struct bt_hog *hog);
+static bool hog_try_create_uhid_from_cache(struct bt_hog *hog);
+
+static void db_cache_write_cb(struct gatt_db_attribute *attr, int err,
+							void *user_data)
+{
+	if (err)
+		error("Error writing cached HoG value to gatt db");
+}
+
+static void db_cache_read_cb(struct gatt_db_attribute *attrib, int err,
+					const uint8_t *value, size_t length,
+					void *user_data)
+{
+	struct iovec *iov = user_data;
+
+	if (err || !value || !length)
+		return;
+
+	iov->iov_base = (void *) value;
+	iov->iov_len = length;
+}
+
+static void hog_cache_write_attr(struct bt_hog *hog, uint16_t handle,
+				uint16_t uuid16, const uint8_t *data,
+				size_t len)
+{
+	struct gatt_db_attribute *attr;
+	const bt_uuid_t *type;
+	bt_uuid_t expected;
+
+	if (!hog->attrib || !hog->gatt_db || !handle || !data || !len)
+		return;
+
+	attr = gatt_db_get_attribute(hog->gatt_db, handle);
+	if (!attr)
+		return;
+
+	type = gatt_db_attribute_get_type(attr);
+	bt_uuid16_create(&expected, uuid16);
+	if (!type || bt_uuid_cmp(type, &expected) != 0)
+		return;
+
+	gatt_db_attribute_write(attr, 0, data, len, 0, NULL,
+						db_cache_write_cb, NULL);
+	hog->cache_dirty = true;
+}
+
+static void hog_notify_cache_updated(struct bt_hog *hog)
+{
+	if (!hog->cache_dirty)
+		return;
+
+	hog->cache_dirty = false;
+	if (hog->cache_updated_cb)
+		hog->cache_updated_cb(hog->cache_updated_data);
+}
 
 static void remove_gatt_req(struct gatt_request *req, uint8_t status)
 {
@@ -159,13 +249,16 @@ static void remove_gatt_req(struct gatt_request *req, uint8_t status)
 
 	queue_remove(hog->gatt_op, req);
 
-	if (!status && queue_isempty(hog->gatt_op)) {
+	if (!status && hog->attrib && queue_isempty(hog->gatt_op)) {
 		/* Report Map must be read last since that can result
 		 * in uhid being created and the driver may start to
 		 * use UHID_SET_REPORT which requires the report->id to
 		 * be known what attribute to send to.
 		 */
-		read_report_map(hog);
+		if (!hog_try_create_uhid_from_cache(hog))
+			read_report_map(hog);
+		if (bt_uhid_started(hog->uhid))
+			hog_notify_cache_updated(hog);
 	}
 
 	destroy_gatt_req(req);
@@ -320,6 +413,18 @@ static void find_included(struct bt_hog *hog, GAttrib *attrib,
 	}
 }
 
+static bool report_payload_active(const uint8_t *data, size_t len)
+{
+	size_t i;
+
+	for (i = 0; i < len; i++) {
+		if (data[i] != 0)
+			return true;
+	}
+
+	return false;
+}
+
 static void report_value_cb(const guint8 *pdu, guint16 len, gpointer user_data)
 {
 	struct report *report = user_data;
@@ -334,10 +439,33 @@ static void report_value_cb(const guint8 *pdu, guint16 len, gpointer user_data)
 	pdu += ATT_NOTIFICATION_HEADER_SIZE;
 	len -= ATT_NOTIFICATION_HEADER_SIZE;
 
+	if (!bt_uhid_started(hog->uhid)) {
+		if (hog->pending_input && !hog->pending_input_overflow) {
+			if (queue_length(hog->pending_input) >=
+							HOG_MAX_PENDING_INPUT) {
+				hog->pending_input_overflow = true;
+				queue_remove_all(hog->pending_input, NULL,
+								NULL, g_free);
+			} else {
+				struct pending_input *item;
+
+				item = g_malloc(sizeof(*item) + len);
+				item->report = report;
+				item->len = len;
+				if (len)
+					memcpy(item->data, pdu, len);
+				queue_push_tail(hog->pending_input, item);
+			}
+		}
+		return;
+	}
+
 	err = bt_uhid_input(hog->uhid, report->numbered ? report->id : 0, pdu,
 				len);
 	if (err < 0)
 		error("bt_uhid_input: %s (%d)", strerror(-err), -err);
+	else
+		report->input_active = report_payload_active(pdu, len);
 }
 
 static void report_notify_destroy(void *user_data)
@@ -349,33 +477,57 @@ static void report_notify_destroy(void *user_data)
 	report->notifyid = 0;
 }
 
-static void report_ccc_written_cb(guint8 status, const guint8 *pdu,
-					guint16 plen, gpointer user_data)
+static void hog_register_report_notify(struct report *report)
 {
-	struct gatt_request *req = user_data;
-	struct report *report = req->user_data;
 	struct bt_hog *hog = report->hog;
 
-	if (status != 0) {
-		error("Write report characteristic descriptor failed: %s",
-							att_ecode2str(status));
-		goto remove;
-	}
-
-	if (report->notifyid)
-		goto remove;
+	if (!hog->attrib || report->notifyid ||
+		(report->ref_known && report->type != HOG_REPORT_TYPE_INPUT))
+		return;
 
 	report->notifyid = g_attrib_register(hog->attrib,
 					ATT_OP_HANDLE_NOTIFY,
 					report->value_handle,
 					report_value_cb, report,
 					report_notify_destroy);
-	if (!report->notifyid) {
+	if (!report->notifyid)
 		error("Unable to register report notification: handle 0x%04x",
 					report->value_handle);
+}
+
+static void ccc_read_cb(guint8 status, const guint8 *pdu, guint16 len,
+							gpointer user_data);
+
+static void hog_subscribe_report(struct report *report)
+{
+	struct bt_hog *hog = report->hog;
+
+	if (!hog->attrib || report->type != HOG_REPORT_TYPE_INPUT)
+		return;
+
+	hog_register_report_notify(report);
+
+	if (report->ccc_handle && !report->ccc_read_queued) {
+		if (read_char(hog, hog->attrib, report->ccc_handle,
+							ccc_read_cb, report))
+			report->ccc_read_queued = true;
+	}
+}
+
+static void report_ccc_written_cb(guint8 status, const guint8 *pdu,
+					guint16 plen, gpointer user_data)
+{
+	struct gatt_request *req = user_data;
+	struct report *report = req->user_data;
+
+	if (status != 0) {
+		error("Write report characteristic descriptor failed: %s",
+							att_ecode2str(status));
 		goto remove;
 	}
 
+	hog_register_report_notify(report);
+
 	DBG("Report characteristic descriptor written: notifications enabled");
 
 remove:
@@ -399,11 +551,21 @@ static void ccc_read_cb(guint8 status, const guint8 *pdu, guint16 len,
 	struct gatt_request *req = user_data;
 	struct report *report = req->user_data;
 
+	report->ccc_read_queued = false;
+
 	if (status != 0) {
 		error("Error reading CCC value: %s", att_ecode2str(status));
 		goto remove;
 	}
 
+	if (!report->hog->attrib)
+		goto remove;
+
+	if (len >= 3 && (get_le16(&pdu[1]) & GATT_CLIENT_CHARAC_CFG_NOTIF_BIT)) {
+		hog_register_report_notify(report);
+		goto remove;
+	}
+
 	write_ccc(report->hog, report->hog->attrib, report->ccc_handle, report);
 
 remove:
@@ -430,6 +592,8 @@ static void report_reference_cb(guint8 status, const guint8 *pdu,
 	struct gatt_request *req = user_data;
 	struct report *report = req->user_data;
 
+	report->ref_pending = false;
+
 	if (status != 0) {
 		error("Read Report Reference descriptor failed: %s",
 							att_ecode2str(status));
@@ -441,16 +605,28 @@ static void report_reference_cb(guint8 status, const guint8 *pdu,
 		goto remove;
 	}
 
+	if (!report->hog->attrib)
+		goto remove;
+
 	report->id = pdu[1];
 	report->type = pdu[2];
+	report->ref_known = true;
+
+	if (report->type >= HOG_REPORT_TYPE_INPUT &&
+				report->type <= HOG_REPORT_TYPE_FEATURE) {
+		uint8_t val[2] = { report->id, report->type };
+
+		hog_cache_write_attr(report->hog, report->ref_handle,
+					GATT_REPORT_REFERENCE, val,
+					sizeof(val));
+	}
 
 	DBG("Report 0x%04x: id 0x%02x type %s", report->value_handle,
 				report->id, type_to_string(report->type));
 
 	/* Enable notifications only for Input Reports */
 	if (report->type == HOG_REPORT_TYPE_INPUT)
-		read_char(report->hog, report->hog->attrib, report->ccc_handle,
-							ccc_read_cb, report);
+		hog_subscribe_report(report);
 
 remove:
 	remove_gatt_req(req, status);
@@ -475,7 +651,7 @@ static void discover_external_cb(uint8_t status, GSList *descs, void *user_data)
 
 		read_char(hog, hog->attrib, desc->handle,
 						external_report_reference_cb,
-						hog);
+						NULL);
 	}
 
 remove:
@@ -634,10 +810,14 @@ static void external_report_reference_cb(guint8 status, const guint8 *pdu,
 					guint16 plen, gpointer user_data)
 {
 	struct gatt_request *req = user_data;
-	struct bt_hog *hog = req->user_data;
+	struct bt_hog *hog = req->hog;
+	uint16_t ext_handle = PTR_TO_UINT(req->user_data);
 	uint16_t uuid16;
 	bt_uuid_t uuid;
 
+	if (hog->ext_pending)
+		hog->ext_pending--;
+
 	if (status != 0) {
 		error("Read External Report Reference descriptor failed: %s",
 							att_ecode2str(status));
@@ -649,6 +829,12 @@ static void external_report_reference_cb(guint8 status, const guint8 *pdu,
 		goto remove;
 	}
 
+	if (!hog->attrib)
+		goto remove;
+
+	hog_cache_write_attr(hog, ext_handle, GATT_EXTERNAL_REPORT_REFERENCE,
+								&pdu[1], 2);
+
 	uuid16 = get_le16(&pdu[1]);
 	DBG("External report reference read, external report characteristic "
 						"UUID: 0x%04x", uuid16);
@@ -657,6 +843,7 @@ static void external_report_reference_cb(guint8 status, const guint8 *pdu,
 	if (uuid16 != HOG_REPORT_UUID)
 		goto remove;
 
+	hog->has_external_reports = true;
 	bt_uuid16_create(&uuid, uuid16);
 	discover_char(hog, hog->attrib, 0x0001, 0xffff, &uuid,
 					external_service_char_cb, hog);
@@ -801,13 +988,47 @@ static void set_numbered(void *data, void *user_data)
 static void start_flags(struct uhid_event *ev, void *user_data)
 {
 	struct bt_hog *hog = user_data;
+	struct pending_input *item;
+
+	if (hog->uhid_start_timeout) {
+		timeout_remove(hog->uhid_start_timeout);
+		hog->uhid_start_timeout = 0;
+	}
 
+	hog->uhid_from_cache = false;
 	hog->uhid_flags = ev->u.start.dev_flags;
 
 	DBG("uHID device flags: 0x%16" PRIx64, hog->uhid_flags);
 
 	if (hog->uhid_flags)
 		g_slist_foreach(hog->reports, set_numbered, hog);
+
+	if (hog->pending_report_map) {
+		hog_cache_write_attr(hog, hog->report_map_handle,
+					HOG_REPORT_MAP_UUID,
+					hog->pending_report_map,
+					hog->pending_report_map_len);
+		free(hog->pending_report_map);
+		hog->pending_report_map = NULL;
+		hog->pending_report_map_len = 0;
+	}
+
+	hog_notify_cache_updated(hog);
+
+	hog->pending_input_overflow = false;
+
+	while (hog->pending_input &&
+			(item = queue_pop_head(hog->pending_input))) {
+		int err = bt_uhid_input(hog->uhid,
+				item->report->numbered ? item->report->id : 0,
+				item->data, item->len);
+		if (err < 0)
+			error("bt_uhid_input: %s (%d)", strerror(-err), -err);
+		else
+			item->report->input_active =
+				report_payload_active(item->data, item->len);
+		g_free(item);
+	}
 }
 
 static void set_report_cb(guint8 status, const guint8 *pdu,
@@ -826,20 +1047,80 @@ static void set_report_cb(guint8 status, const guint8 *pdu,
 		error("bt_uhid_set_report_reply: %s", strerror(-err));
 }
 
+static void set_report(struct uhid_event *ev, void *user_data);
+static void get_report(struct uhid_event *ev, void *user_data);
+
+static void uhid_register_callbacks(struct bt_hog *hog)
+{
+	if (!hog->uhid)
+		return;
+
+	if (!hog->uhid_start_id)
+		hog->uhid_start_id = bt_uhid_register(hog->uhid, UHID_START,
+							start_flags, hog);
+	if (!hog->uhid_output_id)
+		hog->uhid_output_id = bt_uhid_register(hog->uhid, UHID_OUTPUT,
+							forward_report, hog);
+	if (!hog->uhid_getrep_id)
+		hog->uhid_getrep_id = bt_uhid_register(hog->uhid,
+							UHID_GET_REPORT,
+							get_report, hog);
+	if (!hog->uhid_setrep_id)
+		hog->uhid_setrep_id = bt_uhid_register(hog->uhid,
+							UHID_SET_REPORT,
+							set_report, hog);
+}
+
+static void uhid_unregister_callbacks(struct bt_hog *hog, bool keep_start)
+{
+	if (!hog->uhid)
+		return;
+
+	if (!keep_start && hog->uhid_start_id) {
+		bt_uhid_unregister(hog->uhid, hog->uhid_start_id);
+		hog->uhid_start_id = 0;
+	}
+
+	if (hog->uhid_output_id) {
+		bt_uhid_unregister(hog->uhid, hog->uhid_output_id);
+		hog->uhid_output_id = 0;
+	}
+
+	if (hog->uhid_getrep_id) {
+		bt_uhid_unregister(hog->uhid, hog->uhid_getrep_id);
+		hog->uhid_getrep_id = 0;
+	}
+
+	if (hog->uhid_setrep_id) {
+		bt_uhid_unregister(hog->uhid, hog->uhid_setrep_id);
+		hog->uhid_setrep_id = 0;
+	}
+}
+
 static void uhid_destroy(struct bt_hog *hog, bool force)
 {
+	GSList *l;
 	int err;
 
 	if (!hog->uhid)
 		return;
 
-	bt_uhid_unregister_all(hog->uhid);
-
 	err = bt_uhid_destroy(hog->uhid, force);
 	if (err < 0) {
 		error("bt_uhid_destroy: %s", strerror(-err));
 		return;
 	}
+
+	if (!bt_uhid_created(hog->uhid)) {
+		hog->uhid_from_cache = false;
+		for (l = hog->reports; l; l = l->next) {
+			struct report *r = l->data;
+
+			r->input_active = false;
+		}
+	}
+
+	uhid_unregister_callbacks(hog, bt_uhid_created(hog->uhid));
 }
 
 static void set_report(struct uhid_event *ev, void *user_data)
@@ -1013,68 +1294,63 @@ static void uhid_create(struct bt_hog *hog, uint8_t *report_map,
 		return;
 	}
 
-	bt_uhid_register(hog->uhid, UHID_START, start_flags, hog);
-	bt_uhid_register(hog->uhid, UHID_OUTPUT, forward_report, hog);
-	bt_uhid_register(hog->uhid, UHID_GET_REPORT, get_report, hog);
-	bt_uhid_register(hog->uhid, UHID_SET_REPORT, set_report, hog);
+	uhid_register_callbacks(hog);
 
 	DBG("HoG created uHID device");
 }
 
-static void db_report_map_write_value_cb(struct gatt_db_attribute *attr,
-						int err, void *user_data)
-{
-	if (err)
-		error("Error writing report map value to gatt db");
-}
-
 static void report_map_read_cb(guint8 status, const guint8 *pdu, guint16 plen,
 							gpointer user_data)
 {
 	struct gatt_request *req = user_data;
-	struct bt_hog *hog = req->user_data;
-	uint8_t *value;
