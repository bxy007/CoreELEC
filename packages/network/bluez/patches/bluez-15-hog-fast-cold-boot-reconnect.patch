+	hog->uhid_from_cache = true;
+	if (!hog->cache_recovery_tried && !hog->uhid_start_timeout)
+		hog->uhid_start_timeout = timeout_add(HOG_UHID_START_TIMEOUT_MS,
+						uhid_start_timeout_cb, hog,
