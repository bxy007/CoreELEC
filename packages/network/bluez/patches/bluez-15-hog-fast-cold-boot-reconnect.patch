+	if (!hog->attrib || !hog->gatt_db || !hog->report_map_handle ||
+			bt_uhid_created(hog->uhid) || !hog_metadata_ready(hog))
+		return false;
+
+	report_map_attr = gatt_db_get_attribute(hog->gatt_db,
+						hog->report_map_handle);
+	if (!report_map_attr)
+		return false;
