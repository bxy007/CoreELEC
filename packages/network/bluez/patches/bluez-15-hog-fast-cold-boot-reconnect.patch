+
+		if (strlen(*k) != 4 ||
+				!g_ascii_isxdigit((*k)[0]) ||
+				!g_ascii_isxdigit((*k)[1]) ||
+				!g_ascii_isxdigit((*k)[2]) ||
+				!g_ascii_isxdigit((*k)[3]) ||
+				sscanf(*k, "%04hx", &handle_int) != 1)
+			continue;
