+
+		hex = g_key_file_get_string(key_file, "AttributeValues", *k,
+									NULL);
+		if (!hex)
+			continue;
+
+		hex_len = strlen(hex);
+		if (!hex_len || (hex_len % 2) != 0) {
+			g_free(hex);
+			continue;
+		}
+
+		byte_len = hex_len / 2;
+		if (byte_len < min_len || byte_len > max_len) {
+			g_free(hex);
+			continue;
+		}
+
+		buf = g_malloc(byte_len);
+		for (i = 0; i < byte_len; i++) {
+			int hi = g_ascii_xdigit_value(hex[i * 2]);
+			int lo = g_ascii_xdigit_value(hex[i * 2 + 1]);
+
+			if (hi < 0 || lo < 0) {
+				ok = false;
+				break;
+			}
+			buf[i] = (uint8_t)((hi << 4) | lo);
+		}
+
+		if (ok && is_report_ref && (buf[1] < 1 || buf[1] > 3))
+			ok = false;
+
+		if (ok)
+			gatt_db_attribute_write(att, 0, buf, byte_len, 0, NULL,
+							load_desc_value, NULL);
+
+		g_free(buf);
+		g_free(hex);
+	}
+
+	g_strfreev(keys);
+}
